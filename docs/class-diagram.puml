@startuml ArtanSepet_ClassDiagram
' Artan Sepet - UML Sinif Diyagrami (v1.0, 19 Kasim 2026)
' Koddaki son hale gore guncellendi. VS Code'da "PlantUML" eklentisiyle Alt+D ile onizleyin.

skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam linetype ortho
hide empty members

title Artan Sepet - Sinif Diyagrami

' =========================================================
package "model" {
  abstract class User {
    - id : String
    - name : String
    - email : String
    - passwordHash : String
    + checkPassword(raw : String) : boolean
  }

  class Customer {
    - location : Location
    - notifications : List<String>
    + follow(b : Business) : void
    + unfollow(b : Business) : void
    + onNewBag(bag : SurpriseBag) : void
    + updateLocation(l : Location) : void
    + addNotification(msg : String) : void
  }

  class Business {
    - type : BusinessType
    - address : String
    - location : Location
    - followers : Set<BagObserver>
    + subscribe(o : BagObserver) : void
    + unsubscribe(o : BagObserver) : void
    + notifyObservers(bag : SurpriseBag) : void
    + getFollowerCount() : int
  }

  enum BusinessType {
    BAKERY
    PASTRY
    CAFE
    RESTAURANT
    MARKET
    GREENGROCER
    HOTEL
  }

  enum DietaryTag {
    VEGAN
    VEGETARIAN
    GLUTEN_FREE
    HALAL
  }

  class Location <<record>> {
    + latitude : double
    + longitude : double
    + distanceTo(other : Location) : double
  }

  class SurpriseBag {
    - id : String
    - business : Business
    - title : String
    - originalPrice : BigDecimal
    - initialQuantity : int
    - quantity : int
    - pickupStart : LocalDateTime
    - pickupEnd : LocalDateTime
    - tags : Set<DietaryTag>
    - pricingStrategy : PricingStrategy
    - SurpriseBag(b : Builder)
    + {static} builder() : Builder
    + getCurrentPrice(now : LocalDateTime) : BigDecimal
    + reserveOne() : void <<synchronized>>
    + releaseOne() : void <<synchronized>>
    + isAvailable() : boolean
    + isPickupOver(now : LocalDateTime) : boolean
  }

  class "SurpriseBag.Builder" as Builder <<Builder>> {
    + business(b : Business) : Builder
    + title(t : String) : Builder
    + originalPrice(p : BigDecimal) : Builder
    + quantity(q : int) : Builder
    + pickupWindow(start, end) : Builder
    + tag(t : DietaryTag) : Builder
    + pricing(s : PricingStrategy) : Builder
    + build() : SurpriseBag
  }

  class Order {
    - id : String
    - customer : Customer
    - bag : SurpriseBag
    - price : BigDecimal
    - pickupCode : String
    - createdAt : LocalDateTime
    - transactionId : String
    - state : OrderState
    + {static} create(c, bag, code, now) : Order
    + markPaid(transactionId : String) : void
    + markReady() : void
    + pickUp(code : String) : void
    + cancel() : void
    + expire() : void
    + isOverdue(now : LocalDateTime) : boolean
    + isPaid() : boolean
  }
}

User <|-- Customer
User <|-- Business
Business --> BusinessType
Business "1" o-- "*" SurpriseBag : sunar >
SurpriseBag --> "*" DietaryTag
SurpriseBag +-- Builder
Builder ..> SurpriseBag : <<create>>
Customer "1" --> "*" Order : verir >
Order "*" --> "1" SurpriseBag
Customer --> Location
Business --> Location

' =========================================================
package "creation (Factory Method)" {
  abstract class BagFactory {
    + createBag(b, price, qty, start, end) : SurpriseBag
    + createBag(b, price, qty, start, end, pricing) : SurpriseBag
    # {abstract} configure(builder : Builder) : void
    # {abstract} supportedType() : BusinessType
    + {static} forType(t : BusinessType) : BagFactory
  }
  class BakeryBagFactory
  class PastryBagFactory
  class CafeBagFactory
  class RestaurantBagFactory
  class MarketBagFactory
  class GreengrocerBagFactory
  class HotelBagFactory
}

BagFactory <|-- BakeryBagFactory
BagFactory <|-- PastryBagFactory
BagFactory <|-- CafeBagFactory
BagFactory <|-- RestaurantBagFactory
BagFactory <|-- MarketBagFactory
BagFactory <|-- GreengrocerBagFactory
BagFactory <|-- HotelBagFactory
BagFactory ..> Builder : kullanir

' =========================================================
package "state (State)" {
  interface OrderState {
    + markPaid(o : Order) : OrderState
    + markReady(o : Order) : OrderState
    + pickUp(o : Order, code : String) : OrderState
    + cancel(o : Order) : OrderState
    + expire(o : Order) : OrderState
    + displayName() : String
    + isFinal() : boolean
  }
  abstract class AbstractOrderState
  note bottom of AbstractOrderState
    Varsayilan: tum metotlar
    InvalidStateTransitionException firlatir.
    Alt siniflar sadece izinli gecisleri ezer.
  end note
  class ReservedState
  class PaidState
  class ReadyForPickupState
  class PickedUpState
  class CancelledState
  class ExpiredState
}

Order o--> OrderState : state
OrderState <|.. AbstractOrderState
AbstractOrderState <|-- ReservedState
AbstractOrderState <|-- PaidState
AbstractOrderState <|-- ReadyForPickupState
AbstractOrderState <|-- PickedUpState
AbstractOrderState <|-- CancelledState
AbstractOrderState <|-- ExpiredState

' =========================================================
package "pricing (Strategy)" {
  interface PricingStrategy {
    + calculate(bag : SurpriseBag, now : LocalDateTime) : BigDecimal
    + {static} noDiscount() : PricingStrategy
  }
  class FixedDiscountStrategy {
    - rate : BigDecimal
  }
  class LastHourDiscountStrategy {
    - baseRate : BigDecimal
    - lastHourRate : BigDecimal
  }
  class WeekendDiscountStrategy {
    - weekendRate : BigDecimal
  }

  interface BagSortStrategy {
    + comparator(c : Customer, now : LocalDateTime) : Comparator<SurpriseBag>
    + sort(bags, c, now) : List<SurpriseBag>
  }
  class SortByPrice
  class SortByDistance
  class SortByPickupTime
}

SurpriseBag o--> PricingStrategy
PricingStrategy <|.. FixedDiscountStrategy
PricingStrategy <|.. LastHourDiscountStrategy
PricingStrategy <|.. WeekendDiscountStrategy
BagSortStrategy <|.. SortByPrice
BagSortStrategy <|.. SortByDistance
BagSortStrategy <|.. SortByPickupTime

' =========================================================
package "notification (Observer)" {
  interface BagSubject {
    + subscribe(o : BagObserver) : void
    + unsubscribe(o : BagObserver) : void
    + notifyObservers(bag : SurpriseBag) : void
  }
  interface BagObserver {
    + onNewBag(bag : SurpriseBag) : void
  }
}

BagSubject <|.. Business
BagObserver <|.. Customer
Business o--> "*" BagObserver : takipciler

' =========================================================
package "payment (Adapter)" {
  interface PaymentProcessor {
    + charge(c : Customer, amount : BigDecimal, orderId : String) : PaymentResult
    + refund(transactionId : String, amount : BigDecimal) : void
  }
  class PaymentResult <<record>> {
    + success : boolean
    + transactionId : String
    + message : String
  }
  class IyzicoAdapter
  class PaytrAdapter
  class IyzicoClient <<sahte 3. parti>> {
    + createPayment(req : Map<String,Object>) : Map<String,Object>
    + cancelPayment(paymentId : String) : boolean
  }
  class PaytrGateway <<sahte 3. parti>> {
    + sendTransaction(merchantOid : String, kurus : long) : int
    + reverse(merchantOid : String) : void
  }
}

PaymentProcessor <|.. IyzicoAdapter
PaymentProcessor <|.. PaytrAdapter
IyzicoAdapter o--> IyzicoClient
PaytrAdapter o--> PaytrGateway
PaymentProcessor ..> PaymentResult

' =========================================================
package "repository (Singleton + Repository)" {
  class DataStore <<Singleton>> {
    - DataStore()
    + {static} getInstance() : DataStore
    + clear() : void
  }
  interface UserRepository {
    + save(u : User) : void
    + findById(id : String) : Optional<User>
    + findByEmail(email : String) : Optional<User>
    + findAll() : List<User>
  }
  interface BagRepository {
    + save(b : SurpriseBag) : void
    + findById(id : String) : Optional<SurpriseBag>
    + findAvailable() : List<SurpriseBag>
    + findByBusiness(b : Business) : List<SurpriseBag>
  }
  interface OrderRepository {
    + save(o : Order) : void
    + findById(id : String) : Optional<Order>
    + findByCustomer(c : Customer) : List<Order>
    + findByBusiness(b : Business) : List<Order>
    + findOpen() : List<Order>
  }
  class InMemoryUserRepository
  class InMemoryBagRepository
  class InMemoryOrderRepository
}

UserRepository <|.. InMemoryUserRepository
BagRepository <|.. InMemoryBagRepository
OrderRepository <|.. InMemoryOrderRepository
InMemoryUserRepository ..> DataStore
InMemoryBagRepository ..> DataStore
InMemoryOrderRepository ..> DataStore

' =========================================================
package "service (Facade + servisler)" {
  class OrderFacade <<Facade>> {
    + placeOrder(customerId, bagId, now) : Order
    + cancelOrder(orderId : String) : void
    + markReady(orderId : String) : void
    + confirmPickup(orderId : String, code : String) : void
  }
  class BagService {
    + publishBag(b, price, qty, start, end, pricing) : SurpriseBag
    + search(c : Customer, sort : BagSortStrategy, now) : List<SurpriseBag>
    + listBusinessBags(b : Business) : List<SurpriseBag>
  }
  class ExpirationService {
    + expireOverdueOrders(now : LocalDateTime) : int
  }
  class PickupCodeGenerator {
    + generate() : String
  }
}

OrderFacade --> UserRepository
OrderFacade --> BagRepository
OrderFacade --> OrderRepository
OrderFacade --> PaymentProcessor
OrderFacade --> PickupCodeGenerator
BagService --> BagRepository
BagService ..> BagFactory
BagService ..> BagSortStrategy
ExpirationService --> OrderRepository

' =========================================================
package "exception" {
  class ArtanSepetException <<RuntimeException>>
  class BagSoldOutException
  class InvalidStateTransitionException
  class InvalidPickupCodeException
  class PaymentFailedException
  class NotFoundException
}

ArtanSepetException <|-- BagSoldOutException
ArtanSepetException <|-- InvalidStateTransitionException
ArtanSepetException <|-- InvalidPickupCodeException
ArtanSepetException <|-- PaymentFailedException
ArtanSepetException <|-- NotFoundException

AbstractOrderState ..> InvalidStateTransitionException : firlatir
ReadyForPickupState ..> InvalidPickupCodeException : firlatir
SurpriseBag ..> BagSoldOutException : firlatir
OrderFacade ..> PaymentFailedException : firlatir

@enduml
